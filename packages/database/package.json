{
  "name": "@cognita/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:up": "TSX_DISABLE_CACHE=1 node --import tsx src/migrate.ts up",
    "migrate:down": "TSX_DISABLE_CACHE=1 node --import tsx src/migrate.ts down"
  },
  "dependencies": {
    "@cognita/schemas": "workspace:*",
    "kysely": "0.29.5",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/pg": "8.21.0",
    "tsx": "4.23.12"
  }
}
